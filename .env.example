# Supabase credentials for cloud saves (leave blank / delete this file to stay fully local).
# Copy this file to ".env.local" and paste your own values, then restart `npm run dev`.
# Find both in your Supabase project: Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Криптослой интерфейса: кошелёк, покупка DC за ETH, маркетплейс, продажа уток, знак Pons.
# Не задана или любое другое значение: криптослой виден (режим запуска токена).
# off: всё это скрыто, игра работает под гостевой сессией без кошелька.
VITE_CRYPTO=on

# Маркетплейс уток за DC: кнопка Market в шапке и окно обмена.
# Не задана или любое другое значение: маркетплейс скрыт.
# on: маркетплейс виден.
VITE_DCMARKET=off
